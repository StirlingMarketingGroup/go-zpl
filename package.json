{
  "name": "go-zpl",
  "private": true,
  "description": "Development scripts for go-zpl",
  "scripts": {
    "dev": "npm-run-all --parallel wasm:watch site:dev",
    "site:dev": "cd site && hugo server --bind 0.0.0.0 -p 3000",
    "site:build": "cd site && hugo --minify",
    "wasm:build": "cd site/assets/go && GOOS=js GOARCH=wasm go build -o ../../static/lib.wasm .",
    "wasm:watch": "watchexec -e go -w . -w render --ignore site 'npm run wasm:build'",
    "test": "go test -v -race ./...",
    "test:e2e": "npx playwright test",
    "test:watch": "watchexec -e go 'go test ./...'",
    "lint": "golangci-lint run",
    "fmt": "gofmt -s -w . && goimports -w -local github.com/StirlingMarketingGroup/go-zpl .",
    "build": "go build -v ./...",
    "coverage": "go test -v -race -coverprofile=coverage.out -covermode=atomic ./... && go tool cover -html=coverage.out -o coverage.html",
    "render": "go run ./cmd/zplrender",
    "setup": "make setup"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@types/pngjs": "^6.0.5",
    "npm-run-all": "^4.1.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.10"
  }
}
